{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "triage QC verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "defect_class", "defects", "confidence", "round"],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "REVISE", "PARK"] },
    "defect_class": {
      "type": "string",
      "enum": ["root-cause-unproven", "requirement-invented", "stop-list", "repairable", "none"]
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "location", "why"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
          "location": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "round": { "type": "integer", "minimum": 1 }
  }
}
