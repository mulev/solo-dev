{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aso-pipeline",
  "title": "ASO Pipeline Output Schemas",
  "description": "Schemas for all ASO pipeline output files (Phases 1-5). See references/aso-playbook.md for pipeline details.",

  "$defs": {
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Natural-language summary for LLM navigation. ≤200 chars."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD date"
    },

    "phase1_keywords_raw": {
      "type": "object",
      "title": "phase1-keywords-raw.json",
      "description": "Full keyword list with source attribution.",
      "required": ["_summary", "keywords"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keyword", "source", "notes"],
            "properties": {
              "keyword": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["product", "autocomplete", "competitor"]
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase1_keywords_tiered": {
      "type": "object",
      "title": "phase1-keywords-tiered.json",
      "description": "Keywords split into priority tiers for metadata allocation.",
      "required": ["_summary", "tier1", "tier2", "tier3"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "tier1": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "High-intent, moderate competition. Anchor in title and subtitle."
        },
        "tier2": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "Specific use cases, lower competition. Keyword field and description."
        },
        "tier3": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "Longtail, niche. Keyword field fill."
        }
      },
      "additionalProperties": false
    },

    "tiered_keyword": {
      "type": "object",
      "required": ["keyword", "rationale"],
      "properties": {
        "keyword": { "type": "string" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase2_keyword_results": {
      "type": "object",
      "title": "phase2-keyword-results.json",
      "description": "Search results keyed by keyword. Top 20 apps per keyword.",
      "required": ["_summary", "results"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "results": {
          "type": "object",
          "description": "Keyed by keyword string",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/search_result_app" }
          }
        }
      },
      "additionalProperties": false
    },

    "search_result_app": {
      "type": "object",
      "required": ["position", "app_name", "app_slug", "developer", "rating", "ratings_count", "category", "price", "has_iap", "store_url"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "app_name": { "type": "string" },
        "app_slug": { "type": "string" },
        "developer": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "ratings_count": { "type": "integer", "minimum": 0 },
        "category": { "type": "string" },
        "price": { "type": "string" },
        "has_iap": { "type": "boolean" },
        "store_url": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase2_landscape": {
      "type": "object",
      "title": "phase2-landscape.json",
      "description": "Deduplicated app list scored by appearance_count × ratings_count.",
      "required": ["_summary", "apps"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "apps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["app_slug", "app_name", "developer", "appearance_count", "ratings_count", "score", "rating", "category", "store_url"],
            "properties": {
              "app_slug": { "type": "string" },
              "app_name": { "type": "string" },
              "developer": { "type": "string" },
              "appearance_count": { "type": "integer", "minimum": 1 },
              "ratings_count": { "type": "integer", "minimum": 0 },
              "score": { "type": "number" },
              "rating": { "type": "number", "minimum": 1, "maximum": 5 },
              "category": { "type": "string" },
              "store_url": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase3_reviews": {
      "type": "object",
      "title": "phase3/{slug}/reviews.json",
      "description": "App store reviews for a single competitor app.",
      "required": ["_summary", "app_slug", "reviews_count", "average_rating", "reviews"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "app_slug": { "type": "string" },
        "reviews_count": { "type": "integer", "minimum": 0 },
        "average_rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rating", "title", "text", "date", "helpful_count"],
            "properties": {
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
              "title": { "type": ["string", "null"] },
              "text": { "type": "string" },
              "date": { "$ref": "#/$defs/date" },
              "helpful_count": { "type": ["integer", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase3_metadata": {
      "type": "object",
      "title": "phase3/{slug}/metadata.json",
      "description": "Store listing data for a single competitor app.",
      "required": ["_summary", "app_slug", "app_name", "developer", "description", "rating", "ratings_count", "category", "last_updated", "version", "size", "content_rating", "iap_list", "price"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "app_slug": { "type": "string" },
        "app_name": { "type": "string" },
        "developer": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "ratings_count": { "type": "integer", "minimum": 0 },
        "category": { "type": "string" },
        "last_updated": { "$ref": "#/$defs/date" },
        "version": { "type": "string" },
        "size": { "type": "string" },
        "content_rating": { "type": "string" },
        "iap_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "price"],
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "price": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase3_screenshots": {
      "type": "object",
      "title": "phase3/{slug}/screenshots.json",
      "description": "Screenshot analysis for a single competitor app.",
      "required": ["_summary", "app_slug", "screenshots"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "app_slug": { "type": "string" },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "headline", "feature_shown", "primary_claim", "visual_notes"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "headline": { "type": "string" },
              "feature_shown": { "type": "string" },
              "primary_claim": { "type": "string" },
              "visual_notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase3_website": {
      "type": "object",
      "title": "phase3/{slug}/website.json",
      "description": "Marketing website data for a single competitor app.",
      "required": ["_summary", "app_slug", "homepage_url", "homepage_headline", "pricing_url", "pricing_model", "subscription_tiers", "trial", "promotional_pricing", "notes"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "app_slug": { "type": "string" },
        "homepage_url": { "type": "string" },
        "homepage_headline": { "type": "string" },
        "pricing_url": { "type": ["string", "null"] },
        "pricing_model": {
          "type": "string",
          "enum": ["free", "freemium", "subscription", "one_time", "hybrid"]
        },
        "subscription_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "monthly", "features"],
            "properties": {
              "name": { "type": "string" },
              "monthly": { "type": "number" },
              "annual": { "type": ["number", "null"] },
              "features": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        },
        "trial": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["duration_days", "credit_card_required"],
              "properties": {
                "duration_days": { "type": "integer", "minimum": 1 },
                "credit_card_required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "promotional_pricing": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "review_cluster": {
      "type": "object",
      "required": ["theme", "review_count", "percentage", "affected_apps", "example_quotes"],
      "properties": {
        "theme": { "type": "string" },
        "review_count": { "type": "integer", "minimum": 1 },
        "percentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "affected_apps": { "type": "array", "items": { "type": "string" } },
        "example_quotes": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
      },
      "additionalProperties": false
    },

    "phase4_synthesis": {
      "type": "object",
      "title": "phase4-synthesis.json",
      "description": "Cross-app analysis: keyword opportunities, review clusters, feature matrix, value props, pricing landscape.",
      "required": ["_summary", "keyword_opportunities", "complaint_clusters", "praise_clusters", "feature_matrix", "value_prop_map", "pricing_landscape", "assumptions"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "keyword_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["keyword", "demand_proxy", "competition_proxy", "opportunity_score", "tier", "rationale"],
            "properties": {
              "keyword": { "type": "string" },
              "demand_proxy": { "type": "number" },
              "competition_proxy": { "type": "number" },
              "opportunity_score": { "type": "number" },
              "tier": { "type": "integer", "enum": [1, 2, 3] },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "complaint_clusters": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_cluster" }
        },
        "praise_clusters": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_cluster" }
        },
        "feature_matrix": {
          "type": "object",
          "required": ["features", "apps", "classification"],
          "properties": {
            "features": { "type": "array", "items": { "type": "string" } },
            "apps": {
              "type": "object",
              "description": "Keyed by app slug → boolean array matching features order",
              "additionalProperties": {
                "type": "array",
                "items": { "type": "boolean" }
              }
            },
            "classification": {
              "type": "object",
              "required": ["table_stakes", "differentiators", "gaps"],
              "properties": {
                "table_stakes": { "type": "array", "items": { "type": "string" } },
                "differentiators": { "type": "array", "items": { "type": "string" } },
                "gaps": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "value_prop_map": {
          "type": "object",
          "required": ["conventions", "gaps"],
          "properties": {
            "conventions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["theme", "used_by_count", "example_headline"],
                "properties": {
                  "theme": { "type": "string" },
                  "used_by_count": { "type": "integer", "minimum": 1 },
                  "example_headline": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["theme", "evidence"],
                "properties": {
                  "theme": { "type": "string" },
                  "evidence": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "pricing_landscape": {
          "type": "object",
          "required": ["models_present", "price_ranges", "apps"],
          "properties": {
            "models_present": {
              "type": "array",
              "items": { "type": "string", "enum": ["free", "freemium", "subscription", "one_time", "hybrid"] }
            },
            "price_ranges": {
              "type": "object",
              "required": ["monthly", "annual"],
              "properties": {
                "monthly": { "$ref": "#/$defs/price_range" },
                "annual": { "$ref": "#/$defs/price_range" }
              },
              "additionalProperties": false
            },
            "apps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["app_slug", "app_name", "model", "monthly", "annual", "trial_days", "notes"],
                "properties": {
                  "app_slug": { "type": "string" },
                  "app_name": { "type": "string" },
                  "model": { "type": "string", "enum": ["free", "freemium", "subscription", "one_time", "hybrid"] },
                  "monthly": { "type": ["number", "null"] },
                  "annual": { "type": ["number", "null"] },
                  "trial_days": { "type": ["integer", "null"] },
                  "notes": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assumption", "confidence", "invalidation_condition"],
            "properties": {
              "assumption": { "type": "string", "description": "What is being assumed, stated plainly" },
              "confidence": {
                "type": "string",
                "enum": ["confirmed", "high", "medium", "low"],
                "description": "How confident we are this assumption holds"
              },
              "invalidation_condition": { "type": "string", "description": "What evidence would prove this assumption wrong" }
            },
            "additionalProperties": false
          },
          "description": "Explicit list of assumptions underlying synthesis conclusions. Downstream phases and future runs use this to verify whether prior conclusions still hold."
        }
      },
      "additionalProperties": false
    },

    "price_range": {
      "type": "object",
      "required": ["min", "max", "median"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "median": { "type": "number" }
      },
      "additionalProperties": false
    },

    "metadata_field": {
      "type": "object",
      "required": ["text", "rationale"],
      "properties": {
        "text": { "type": "string" },
        "chars": { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase5_metadata": {
      "type": "object",
      "title": "phase5-metadata.json",
      "description": "Metadata draft for App Store and Play Store, plus screenshot concepts.",
      "required": ["_summary", "app_store", "play_store", "screenshot_concepts"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "app_store": {
          "type": "object",
          "required": ["title", "subtitle", "keyword_field", "long_description"],
          "properties": {
            "title": { "$ref": "#/$defs/metadata_field" },
            "subtitle": { "$ref": "#/$defs/metadata_field" },
            "keyword_field": { "$ref": "#/$defs/metadata_field" },
            "long_description": { "$ref": "#/$defs/metadata_field" }
          },
          "additionalProperties": false
        },
        "play_store": {
          "type": "object",
          "required": ["title", "short_description", "long_description"],
          "properties": {
            "title": { "$ref": "#/$defs/metadata_field" },
            "short_description": { "$ref": "#/$defs/metadata_field" },
            "long_description": { "$ref": "#/$defs/metadata_field" }
          },
          "additionalProperties": false
        },
        "screenshot_concepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["position", "headline", "feature", "rationale"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "headline": { "type": "string" },
              "feature": { "type": "string" },
              "rationale": { "type": "string" },
              "visual_direction": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
