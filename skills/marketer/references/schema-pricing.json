{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pricing-pipeline",
  "title": "Pricing Pipeline Output Schemas",
  "description": "Schemas for all pricing pipeline output files (Phases 1-5). See references/pricing-playbook.md for pipeline details.",

  "$defs": {
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Natural-language summary for LLM navigation. ≤200 chars."
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "pricing_model": {
      "type": "string",
      "enum": ["free", "freemium", "subscription", "one_time", "hybrid"]
    },
    "confidence_level": {
      "type": "string",
      "enum": ["confirmed", "high", "medium", "low"]
    },
    "iap_type": {
      "type": "string",
      "enum": ["consumable", "non_consumable"]
    },
    "research_method": {
      "type": "string",
      "enum": ["van_westendorp", "gabor_granger", "conjoint", "pricing_page_ab"]
    },

    "phase1_aggregated_pricing": {
      "type": "object",
      "title": "phase1-aggregated-pricing.json",
      "description": "Pricing data collected from existing pipeline outputs + gap-filling scrapes.",
      "required": ["_summary", "sources", "competitors", "gaps"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "sources": {
          "type": "object",
          "description": "Pipeline run IDs and fresh scrape targets",
          "properties": {
            "competitive_pipeline": { "type": ["string", "null"] },
            "aso_pipeline": { "type": ["string", "null"] },
            "fresh_scrapes": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "competitors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "slug", "data_source", "model", "has_iap", "has_subscription", "website_pricing_url", "app_store_price", "notes"],
            "properties": {
              "name": { "type": "string" },
              "slug": { "type": "string" },
              "data_source": { "type": "string", "description": "Pipeline run ID or 'fresh_scrape'" },
              "model": { "$ref": "#/$defs/pricing_model" },
              "has_iap": { "type": "boolean" },
              "has_subscription": { "type": "boolean" },
              "website_pricing_url": { "type": ["string", "null"] },
              "app_store_price": { "type": ["string", "null"] },
              "tiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "monthly", "features_summary"],
                  "properties": {
                    "name": { "type": "string" },
                    "monthly": { "type": "number" },
                    "annual": { "type": ["number", "null"] },
                    "features_summary": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "trial": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["duration_days", "credit_card_required"],
                    "properties": {
                      "duration_days": { "type": "integer", "minimum": 1 },
                      "credit_card_required": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Competitors with missing or incomplete pricing data"
        }
      },
      "additionalProperties": false
    },

    "phase2_architectures": {
      "type": "object",
      "title": "phase2-architectures.json",
      "description": "Detailed pricing architecture analysis per competitor + category patterns.",
      "required": ["_summary", "architectures", "category_patterns"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "architectures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "slug", "model", "tier_count", "tiers", "upgrade_trigger", "trial", "platform_strategy", "pricing_signals"],
            "properties": {
              "name": { "type": "string" },
              "slug": { "type": "string" },
              "model": { "$ref": "#/$defs/pricing_model" },
              "tier_count": { "type": "integer", "minimum": 1 },
              "tiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "price_monthly", "price_annual", "key_features"],
                  "properties": {
                    "name": { "type": "string" },
                    "price_monthly": { "type": "number" },
                    "price_annual": { "type": ["number", "null"] },
                    "key_features": { "type": "array", "items": { "type": "string" } },
                    "key_limitations": { "type": "array", "items": { "type": "string" } },
                    "annual_discount_pct": { "type": "number" }
                  },
                  "additionalProperties": false
                }
              },
              "upgrade_trigger": { "type": "string" },
              "trial": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["duration_days", "full_access", "credit_card_required"],
                    "properties": {
                      "duration_days": { "type": "integer", "minimum": 1 },
                      "full_access": { "type": "boolean" },
                      "credit_card_required": { "type": "boolean" }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "platform_strategy": { "type": "string" },
              "pricing_signals": {
                "type": "object",
                "required": ["annual_presented_first", "savings_messaging", "student_pricing", "enterprise_pricing"],
                "properties": {
                  "annual_presented_first": { "type": "boolean" },
                  "savings_messaging": { "type": ["string", "null"] },
                  "student_pricing": { "type": "boolean" },
                  "enterprise_pricing": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "category_patterns": {
          "type": "object",
          "required": ["dominant_model", "dominant_model_count", "median_price_monthly", "median_price_annual", "average_tier_count", "most_common_trial_duration_days", "average_annual_discount_pct", "standard_free_features", "standard_paid_gates"],
          "properties": {
            "dominant_model": { "$ref": "#/$defs/pricing_model" },
            "dominant_model_count": { "type": "integer", "minimum": 1 },
            "median_price_monthly": { "type": "number" },
            "median_price_annual": { "type": "number" },
            "average_tier_count": { "type": "number" },
            "most_common_trial_duration_days": { "type": "integer" },
            "average_annual_discount_pct": { "type": "number" },
            "standard_free_features": { "type": "array", "items": { "type": "string" } },
            "standard_paid_gates": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "phase3_sensitivity": {
      "type": "object",
      "title": "phase3-sensitivity.json",
      "description": "Price sensitivity research from reviews, community signals, and comparison content.",
      "required": ["_summary", "review_sentiment", "community_signals", "comparison_content"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "review_sentiment": {
          "type": "object",
          "required": ["total_reviews_analyzed", "reviews_mentioning_price", "price_mention_rate_pct", "sentiment_breakdown", "model_resistance", "price_threshold_signals"],
          "properties": {
            "total_reviews_analyzed": { "type": "integer", "minimum": 0 },
            "reviews_mentioning_price": { "type": "integer", "minimum": 0 },
            "price_mention_rate_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "sentiment_breakdown": {
              "type": "object",
              "required": ["positive", "negative", "comparison", "feature_price"],
              "properties": {
                "positive": { "$ref": "#/$defs/sentiment_bucket" },
                "negative": { "$ref": "#/$defs/sentiment_bucket" },
                "comparison": { "$ref": "#/$defs/sentiment_bucket" },
                "feature_price": { "$ref": "#/$defs/sentiment_bucket" }
              },
              "additionalProperties": false
            },
            "model_resistance": {
              "type": "object",
              "required": ["subscription_fatigue_mentions", "want_one_time_purchase_mentions", "examples"],
              "properties": {
                "subscription_fatigue_mentions": { "type": "integer", "minimum": 0 },
                "want_one_time_purchase_mentions": { "type": "integer", "minimum": 0 },
                "examples": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "price_threshold_signals": { "type": "string" }
          },
          "additionalProperties": false
        },
        "community_signals": {
          "type": "object",
          "required": ["sources_scraped", "threads_analyzed", "key_findings"],
          "properties": {
            "sources_scraped": { "type": "array", "items": { "type": "string" } },
            "threads_analyzed": { "type": "integer", "minimum": 0 },
            "key_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["finding", "source", "confidence"],
                "properties": {
                  "finding": { "type": "string" },
                  "source": { "type": "string" },
                  "confidence": { "$ref": "#/$defs/confidence_level" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "comparison_content": {
          "type": "object",
          "required": ["pages_analyzed", "key_findings"],
          "properties": {
            "pages_analyzed": { "type": "integer", "minimum": 0 },
            "key_findings": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["finding", "source"],
                "properties": {
                  "finding": { "type": "string" },
                  "source": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "sentiment_bucket": {
      "type": "object",
      "required": ["count", "pct", "example_quotes"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "example_quotes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "phase4_synthesis": {
      "type": "object",
      "title": "phase4-synthesis.json",
      "description": "Pricing analysis synthesis: landscape, sensitivity, model/tier/price recommendations, revenue scenarios.",
      "required": ["_summary", "pricing_landscape", "sensitivity_summary", "value_metric", "model_recommendation", "tier_recommendation", "price_points", "revenue_scenarios", "assumptions"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "pricing_landscape": {
          "type": "object",
          "required": ["competitors_analyzed", "models_distribution", "price_distribution"],
          "properties": {
            "competitors_analyzed": { "type": "integer", "minimum": 1 },
            "models_distribution": {
              "type": "object",
              "description": "Keyed by model name → count",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            },
            "price_distribution": {
              "type": "object",
              "required": ["monthly", "annual"],
              "properties": {
                "monthly": { "$ref": "#/$defs/price_range" },
                "annual": { "$ref": "#/$defs/price_range" },
                "one_time": { "$ref": "#/$defs/price_range" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "sensitivity_summary": { "type": "string" },
        "value_metric": {
          "type": "object",
          "required": ["recommended", "rationale", "alternatives_considered", "why_rejected"],
          "properties": {
            "recommended": { "type": "string" },
            "rationale": { "type": "string" },
            "alternatives_considered": { "type": "array", "items": { "type": "string" } },
            "why_rejected": { "type": "string" }
          },
          "additionalProperties": false
        },
        "model_recommendation": {
          "type": "object",
          "required": ["primary", "rationale", "secondary", "confidence"],
          "properties": {
            "primary": { "type": "string" },
            "rationale": { "type": "string" },
            "secondary": { "type": ["string", "null"] },
            "confidence": { "$ref": "#/$defs/confidence_level" }
          },
          "additionalProperties": false
        },
        "tier_recommendation": {
          "type": "object",
          "required": ["tiers", "tier_count_rationale"],
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "features", "rationale"],
                "properties": {
                  "name": { "type": "string" },
                  "features": { "type": "array", "items": { "type": "string" } },
                  "upgrade_trigger": { "type": ["string", "null"] },
                  "rationale": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "tier_count_rationale": {
              "type": "string",
              "description": "Why this number of tiers — cite competitive analysis (category median tier count) and audience research (decision complexity tolerance). Required."
            }
          },
          "additionalProperties": false
        },
        "price_points": {
          "type": "object",
          "description": "Keyed by tier/product identifier (e.g. pro_monthly, pro_annual, one_time_filter_packs)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "floor": { "type": "number" },
              "target": { "type": "number" },
              "ceiling": { "type": "number" },
              "annual_discount_pct": { "type": "number" },
              "savings_messaging": { "type": "string" },
              "rationale": { "type": "string" },
              "confidence": { "$ref": "#/$defs/confidence_level" }
            },
            "required": ["target", "rationale"]
          }
        },
        "revenue_scenarios": {
          "type": "object",
          "required": ["assumptions", "conservative", "target", "optimistic"],
          "properties": {
            "assumptions": {
              "type": "object",
              "required": ["monthly_new_users", "source"],
              "properties": {
                "monthly_new_users": { "type": "integer", "minimum": 0 },
                "source": { "type": "string" }
              },
              "additionalProperties": false
            },
            "conservative": { "$ref": "#/$defs/revenue_scenario" },
            "target": { "$ref": "#/$defs/revenue_scenario" },
            "optimistic": { "$ref": "#/$defs/revenue_scenario" }
          },
          "additionalProperties": false
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assumption", "confidence", "invalidation_condition"],
            "properties": {
              "assumption": { "type": "string", "description": "What is being assumed, stated plainly" },
              "confidence": {
                "type": "string",
                "enum": ["confirmed", "high", "medium", "low"],
                "description": "How confident we are this assumption holds"
              },
              "invalidation_condition": { "type": "string", "description": "What evidence would prove this assumption wrong" }
            },
            "additionalProperties": false
          },
          "description": "Explicit list of assumptions underlying synthesis conclusions. Downstream phases and future runs use this to verify whether prior conclusions still hold."
        }
      },
      "additionalProperties": false
    },

    "price_range": {
      "type": "object",
      "required": ["min", "max", "median"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "median": { "type": "number" }
      },
      "additionalProperties": false
    },

    "revenue_scenario": {
      "type": "object",
      "required": ["trial_to_paid_pct", "monthly_churn_pct", "monthly_revenue", "annual_revenue", "ltv_per_subscriber", "notes"],
      "properties": {
        "trial_to_paid_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "monthly_churn_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "monthly_revenue": { "type": "number" },
        "annual_revenue": { "type": "number" },
        "ltv_per_subscriber": { "type": "number" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase5_strategy": {
      "type": "object",
      "title": "phase5-strategy.json",
      "description": "Actionable pricing strategy: model, tiers, trial, platform pricing, localization, testing plan.",
      "required": ["_summary", "recommended_model", "recommended_tiers", "one_time_iaps", "trial_structure", "platform_pricing", "localized_pricing", "ab_testing_plan", "primary_research_design"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "recommended_model": {
          "type": "object",
          "required": ["model", "rationale"],
          "properties": {
            "model": { "type": "string" },
            "rationale": { "type": "string" }
          },
          "additionalProperties": false
        },
        "recommended_tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "features", "target_audience"],
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "number" },
              "price_monthly": { "type": "number" },
              "price_annual": { "type": "number" },
              "annual_discount_pct": { "type": "number" },
              "features": { "type": "array", "items": { "type": "string" } },
              "limitations": { "type": "array", "items": { "type": "string" } },
              "upgrade_trigger": { "type": "string" },
              "target_audience": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "one_time_iaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "price", "type", "rationale"],
            "properties": {
              "name": { "type": "string" },
              "price": { "type": "number" },
              "type": { "$ref": "#/$defs/iap_type" },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "trial_structure": {
          "type": "object",
          "required": ["duration_days", "access_level", "credit_card_required", "rationale", "conversion_optimization"],
          "properties": {
            "duration_days": { "type": "integer", "minimum": 0 },
            "access_level": { "type": "string" },
            "credit_card_required": { "type": "boolean" },
            "rationale": { "type": "string" },
            "conversion_optimization": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "platform_pricing": {
          "type": "object",
          "description": "Keyed by platform: app_store, play_store, web_direct",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "monthly": { "type": "string" },
              "monthly_tier": { "type": "string" },
              "annual": { "type": "string" },
              "annual_tier": { "type": "string" },
              "trial": { "type": "string" },
              "introductory_offer": { "type": "string" },
              "recommended": { "type": "boolean" },
              "rationale": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        },
        "localized_pricing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["market", "monthly", "annual", "currency"],
            "properties": {
              "market": { "type": "string" },
              "monthly": { "type": "number" },
              "annual": { "type": "number" },
              "currency": { "type": "string" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "ab_testing_plan": {
          "type": "object",
          "required": ["first_test"],
          "properties": {
            "first_test": { "$ref": "#/$defs/ab_test" },
            "second_test": { "$ref": "#/$defs/ab_test" }
          },
          "additionalProperties": false
        },
        "primary_research_design": {
          "type": "object",
          "required": ["method", "when_to_run", "questions", "target_respondents", "sample_size", "distribution"],
          "properties": {
            "method": { "$ref": "#/$defs/research_method" },
            "when_to_run": { "type": "string" },
            "questions": { "type": "array", "items": { "type": "string" } },
            "target_respondents": { "type": "string" },
            "sample_size": { "type": "string" },
            "distribution": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "ab_test": {
      "type": "object",
      "required": ["variable", "hypothesis", "primary_metric", "minimum_sample", "duration", "traffic_split"],
      "properties": {
        "variable": { "type": "string" },
        "hypothesis": { "type": "string" },
        "primary_metric": { "type": "string" },
        "minimum_sample": { "type": "integer", "minimum": 1 },
        "duration": { "type": "string" },
        "traffic_split": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
