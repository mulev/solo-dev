{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product-foundation",
  "title": "Product Foundation",
  "description": "Shared product data at {project_root}/research/product-foundation.json. Read by all pipelines. Intake process in references/product-foundation.md.",
  "type": "object",
  "required": ["_summary", "version", "created_at", "updated_at", "identity", "value_proposition", "audiences", "positioning", "business", "current_marketing"],
  "properties": {
    "_summary": { "$ref": "#/$defs/summary" },
    "version": { "type": "integer", "minimum": 1, "description": "Bump on every write" },
    "created_at": { "$ref": "#/$defs/datetime" },
    "updated_at": { "$ref": "#/$defs/datetime" },
    "identity": { "$ref": "#/$defs/identity" },
    "value_proposition": { "$ref": "#/$defs/value_proposition" },
    "audiences": { "$ref": "#/$defs/audiences" },
    "positioning": { "$ref": "#/$defs/positioning" },
    "business": { "$ref": "#/$defs/business" },
    "current_marketing": { "$ref": "#/$defs/current_marketing" },
    "observed_data": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/observed_data" }
      ],
      "description": "Populated by research-and-verify step during intake. null if product is not live."
    },
    "learned": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/learned" }
      ],
      "description": "Created and updated by pipelines after synthesis. Does not exist at intake time."
    }
  },
  "additionalProperties": false,

  "$defs": {
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Natural-language summary for LLM navigation. ≤200 chars."
    },
    "datetime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "YYYY-MM-DD date"
    },
    "learned_meta": {
      "type": "object",
      "description": "Common fields present in every learned sub-object",
      "required": ["updated_at", "source", "notes"],
      "properties": {
        "updated_at": { "$ref": "#/$defs/datetime" },
        "source": { "type": "string", "description": "Pipeline run ID, e.g. aso-2026-04-05T14-23-00" },
        "notes": { "type": "string", "description": "Methodology and confidence summary" }
      }
    },

    "identity": {
      "type": "object",
      "required": ["name", "description", "problem_solved", "platforms", "stage", "is_live"],
      "properties": {
        "name": { "type": "string" },
        "tagline": { "type": ["string", "null"] },
        "description": { "type": "string", "description": "Functional description, 1-2 sentences" },
        "problem_solved": { "type": "string", "description": "Problem + for whom" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["ios", "android", "web", "desktop", "macos", "windows", "linux"] },
          "minItems": 1
        },
        "stage": { "type": "string", "enum": ["idea", "mvp", "launched", "growth", "mature"] },
        "is_live": { "type": "boolean" },
        "store_urls": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "app_store": { "type": ["string", "null"] },
                "play_store": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "website_url": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },

    "value_proposition": {
      "type": "object",
      "required": ["one_sentence", "mechanism", "features"],
      "properties": {
        "one_sentence": { "type": "string", "description": "The 'friend explanation' — plain language" },
        "mechanism": { "type": "string", "description": "How the product delivers the value" },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "importance", "description"],
            "properties": {
              "name": { "type": "string" },
              "importance": { "type": "string", "enum": ["primary", "secondary", "tertiary"] },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "audience_profile": {
      "type": "object",
      "required": ["description", "needs", "current_behavior"],
      "properties": {
        "description": { "type": "string" },
        "needs": { "type": "string" },
        "current_behavior": { "type": "string" }
      },
      "additionalProperties": false
    },

    "audiences": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/audience_profile" },
        "secondary": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/audience_profile" }
          ]
        },
        "anti_audience": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["description", "reason"],
              "properties": {
                "description": { "type": "string" },
                "reason": { "type": "string", "description": "Why they are excluded" }
              },
              "additionalProperties": false
            }
          ],
          "description": "Strongly encouraged — sharpens positioning"
        }
      },
      "additionalProperties": false
    },

    "positioning": {
      "type": "object",
      "required": ["category_frame", "category_strategy", "differentiators", "main_alternatives"],
      "properties": {
        "category_frame": { "type": "string", "description": "How the user describes the product's category" },
        "category_strategy": {
          "type": "string",
          "enum": ["own", "reframe", "replace"],
          "description": "own = new category; reframe = modifier on existing; replace = positioned against specific alternative"
        },
        "positioning_statement": { "type": ["string", "null"], "description": "Internal tool, not customer copy" },
        "differentiators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim", "evidence", "is_validated"],
            "properties": {
              "claim": { "type": "string" },
              "evidence": { "type": "string" },
              "is_validated": { "type": "boolean", "description": "Pipelines should prioritize validating false entries" }
            },
            "additionalProperties": false
          }
        },
        "main_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "type", "positioning"],
            "properties": {
              "name": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["direct", "indirect", "alternative"],
                "description": "direct = same category/audience; indirect = adjacent; alternative = different solution to same problem"
              },
              "positioning": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "business": {
      "type": "object",
      "required": ["model", "geographic_scope", "supported_locales"],
      "properties": {
        "model": {
          "type": "string",
          "enum": ["subscription", "freemium", "one_time", "ad_supported", "free", "hybrid"]
        },
        "pricing": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "free_tier": { "type": ["string", "null"] },
                "tiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "features"],
                    "properties": {
                      "name": { "type": "string" },
                      "monthly": { "type": ["number", "null"] },
                      "annual": { "type": ["number", "null"] },
                      "features": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                },
                "trial": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["duration_days", "credit_card_required"],
                      "properties": {
                        "duration_days": { "type": "integer" },
                        "credit_card_required": { "type": "boolean" }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "revenue_target": { "type": ["string", "null"] },
        "geographic_scope": { "type": "array", "items": { "type": "string" } },
        "supported_locales": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "current_marketing": {
      "type": "object",
      "required": ["channels"],
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["channel", "status"],
            "properties": {
              "channel": { "type": "string" },
              "status": { "type": "string", "enum": ["active", "inactive", "planned"] },
              "notes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "current_metadata": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "app_store_title": { "type": ["string", "null"] },
                "app_store_subtitle": { "type": ["string", "null"] },
                "keyword_field": { "type": ["string", "null"] },
                "website_meta_title": { "type": ["string", "null"] },
                "website_meta_description": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          ]
        },
        "whats_working": { "type": ["string", "null"] },
        "whats_not_working": { "type": ["string", "null"] },
        "past_research": { "type": ["string", "null"], "description": "Pointer to existing research, not embedded data" }
      },
      "additionalProperties": false
    },

    "observed_data": {
      "type": "object",
      "required": ["source", "scraped_at"],
      "properties": {
        "source": { "type": "string", "description": "e.g. store_scrape, website_visit" },
        "scraped_at": { "$ref": "#/$defs/datetime" },
        "app_store": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["rating", "ratings_count", "last_updated", "current_version"],
              "properties": {
                "rating": { "type": "number", "minimum": 1, "maximum": 5 },
                "ratings_count": { "type": "integer", "minimum": 0 },
                "last_updated": { "$ref": "#/$defs/date" },
                "current_version": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        },
        "play_store": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["rating", "ratings_count", "last_updated", "installs"],
              "properties": {
                "rating": { "type": "number", "minimum": 1, "maximum": 5 },
                "ratings_count": { "type": "integer", "minimum": 0 },
                "last_updated": { "$ref": "#/$defs/date" },
                "installs": { "type": "string", "description": "As displayed by Play Store, e.g. 100K+" }
              },
              "additionalProperties": false
            }
          ]
        },
        "website": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["homepage_headline", "has_blog", "has_pricing_page"],
              "properties": {
                "homepage_headline": { "type": "string" },
                "has_blog": { "type": "boolean" },
                "blog_post_count": { "type": ["integer", "null"] },
                "has_pricing_page": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },

    "learned": {
      "type": "object",
      "description": "Created by pipelines, not intake. Each sub-object has updated_at + source + notes. Staleness: <3mo use as-is, 3-6mo verify, >6mo re-research.",
      "properties": {
        "competitive_set": {
          "description": "Written by: ASO, SEO, competitive intelligence. Mode: merge.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "direct": { "type": "array", "items": { "$ref": "#/$defs/competitor_entry" } },
            "indirect": { "type": "array", "items": { "$ref": "#/$defs/competitor_entry" } },
            "content_competitors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["domain", "positioning"],
                "properties": {
                  "domain": { "type": "string" },
                  "positioning": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["updated_at", "source", "direct", "indirect", "notes"]
        },
        "category_vocabulary": {
          "description": "Written by: ASO, SEO. Mode: merge.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "user_search_terms": { "type": "array", "items": { "type": "string" } },
            "praise_language": { "type": "array", "items": { "type": "string" } },
            "complaint_language": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["updated_at", "source", "user_search_terms", "praise_language", "complaint_language", "notes"]
        },
        "feature_landscape": {
          "description": "Written by: ASO, competitive intelligence. Mode: replace.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "table_stakes": { "type": "array", "items": { "type": "string" }, "description": "Present in 8+ of top 10" },
            "differentiators": { "type": "array", "items": { "type": "string" }, "description": "Present in 3-7 of top 10" },
            "gaps": { "type": "array", "items": { "type": "string" }, "description": "Present in 0-2 but requested in reviews" }
          },
          "required": ["updated_at", "source", "table_stakes", "differentiators", "gaps", "notes"]
        },
        "validated_positioning": {
          "description": "Written by: competitive intelligence, pricing. Mode: merge.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "differentiators_status": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["claim", "status", "evidence"],
                "properties": {
                  "claim": { "type": "string" },
                  "status": { "type": "string", "enum": ["validated", "partially_validated", "invalidated", "unvalidated"] },
                  "evidence": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "positioning_gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["gap", "evidence", "opportunity"],
                "properties": {
                  "gap": { "type": "string" },
                  "evidence": { "type": "string" },
                  "opportunity": { "type": "string", "enum": ["high", "medium", "low"] }
                },
                "additionalProperties": false
              }
            }
          },
          "required": ["updated_at", "source", "differentiators_status", "positioning_gaps", "notes"]
        },
        "search_landscape": {
          "description": "Written by: SEO. Mode: replace.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "demand_confirmed": { "type": "array", "items": { "type": "string" } },
            "demand_absent": { "type": "array", "items": { "type": "string" } },
            "topical_clusters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["cluster", "keywords_count", "hub_potential"],
                "properties": {
                  "cluster": { "type": "string" },
                  "keywords_count": { "type": "integer", "minimum": 1 },
                  "hub_potential": { "type": "string", "enum": ["high", "medium", "low"] }
                },
                "additionalProperties": false
              }
            },
            "content_gaps_with_demand": { "type": "array", "items": { "type": "string" } },
            "dominant_formats": {
              "type": "object",
              "required": ["transactional", "informational", "commercial"],
              "properties": {
                "transactional": { "type": "string" },
                "informational": { "type": "string" },
                "commercial": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "required": ["updated_at", "source", "demand_confirmed", "demand_absent", "topical_clusters", "content_gaps_with_demand", "dominant_formats", "notes"]
        },
        "pricing_intelligence": {
          "description": "Written by: pricing (primary), competitive intelligence (partial). Mode: replace.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "category_norms": {
              "type": "object",
              "required": ["dominant_model", "standard_free_features", "standard_paid_gates"],
              "properties": {
                "dominant_model": { "type": "string", "enum": ["subscription", "freemium", "one_time", "ad_supported", "free", "hybrid"] },
                "median_monthly": { "type": ["number", "null"] },
                "median_annual": { "type": ["number", "null"] },
                "standard_free_features": { "type": "array", "items": { "type": "string" } },
                "standard_paid_gates": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            },
            "price_sensitivity_profile": {
              "type": "object",
              "required": ["acceptable_range_monthly", "complaint_threshold_monthly", "model_resistance_signals"],
              "properties": {
                "acceptable_range_monthly": {
                  "type": "object",
                  "required": ["floor", "ceiling"],
                  "properties": {
                    "floor": { "type": "number" },
                    "ceiling": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "complaint_threshold_monthly": { "type": "number" },
                "model_resistance_signals": { "type": "string" }
              },
              "additionalProperties": false
            },
            "recommended_value_metric": { "type": "string" }
          },
          "required": ["updated_at", "source", "category_norms", "price_sensitivity_profile", "recommended_value_metric", "notes"]
        },
        "audience_insights": {
          "description": "Written by: ASO, competitive intelligence. Mode: merge.",
          "allOf": [{ "$ref": "#/$defs/learned_meta" }],
          "properties": {
            "updated_at": true, "source": true, "notes": true,
            "observed_user_segments": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["segment", "signals", "size_signal"],
                "properties": {
                  "segment": { "type": "string" },
                  "signals": { "type": "string" },
                  "size_signal": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "top_user_needs": { "type": "array", "items": { "type": "string" } },
            "top_user_frustrations": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["updated_at", "source", "observed_user_segments", "top_user_needs", "top_user_frustrations", "notes"]
        }
      },
      "additionalProperties": false
    },

    "competitor_entry": {
      "type": "object",
      "required": ["name", "slug", "positioning"],
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string", "description": "Lowercase, hyphenated" },
        "ratings_count": { "type": ["integer", "null"] },
        "rating": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
        "positioning": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
