{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo-pipeline",
  "title": "SEO Pipeline Output Schemas",
  "description": "Schemas for all SEO pipeline output files (Phases 1-5). See references/seo-playbook.md for pipeline details.",

  "$defs": {
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Natural-language summary for LLM navigation. ≤200 chars."
    },
    "search_intent": {
      "type": "string",
      "enum": ["transactional", "commercial", "informational", "navigational"]
    },
    "content_type": {
      "type": "string",
      "enum": ["landing_page", "blog_post", "listicle", "comparison", "tool", "video", "documentation"]
    },
    "content_depth": {
      "type": "string",
      "enum": ["short", "medium", "long"],
      "description": "short: <1000 words, medium: 1000-3000, long: 3000+"
    },
    "coverage_level": {
      "type": "string",
      "enum": ["deep", "shallow", "none"]
    },
    "strength_level": {
      "type": "string",
      "enum": ["strong", "moderate", "weak", "none"]
    },
    "hub_potential": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },

    "phase1_keywords_raw": {
      "type": "object",
      "title": "phase1-keywords-raw.json",
      "description": "Full keyword list with source and intent attribution.",
      "required": ["_summary", "keywords"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["keyword", "source", "intent", "notes"],
            "properties": {
              "keyword": { "type": "string" },
              "source": {
                "type": "string",
                "enum": ["product", "autocomplete", "related_search", "paa", "competitor"]
              },
              "intent": { "$ref": "#/$defs/search_intent" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase1_keywords_tiered": {
      "type": "object",
      "title": "phase1-keywords-tiered.json",
      "description": "Keywords split into priority tiers with intent classification.",
      "required": ["_summary", "tier1", "tier2", "tier3"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "tier1": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "High intent, commercial or transactional. Dedicated landing pages."
        },
        "tier2": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "Informational, moderate volume. Long-form guides, tutorials."
        },
        "tier3": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tiered_keyword" },
          "description": "Longtail, question-based. Blog posts, FAQ, help articles."
        }
      },
      "additionalProperties": false
    },

    "tiered_keyword": {
      "type": "object",
      "required": ["keyword", "intent", "rationale"],
      "properties": {
        "keyword": { "type": "string" },
        "intent": { "$ref": "#/$defs/search_intent" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },

    "phase2_keyword_results": {
      "type": "object",
      "title": "phase2-keyword-results.json",
      "description": "SERP results keyed by keyword. Top 20 organic results per keyword plus SERP features.",
      "required": ["_summary", "results"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "results": {
          "type": "object",
          "description": "Keyed by keyword string",
          "additionalProperties": {
            "type": "object",
            "required": ["serp_features", "featured_snippet_owner", "organic"],
            "properties": {
              "serp_features": {
                "type": "array",
                "items": { "type": "string" }
              },
              "featured_snippet_owner": { "type": ["string", "null"] },
              "organic": {
                "type": "array",
                "items": { "$ref": "#/$defs/serp_result" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "serp_result": {
      "type": "object",
      "required": ["position", "url", "domain", "title_tag", "meta_description", "content_type", "content_depth"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "domain": { "type": "string" },
        "title_tag": { "type": "string" },
        "meta_description": { "type": "string" },
        "content_type": { "$ref": "#/$defs/content_type" },
        "content_depth": { "$ref": "#/$defs/content_depth" }
      },
      "additionalProperties": false
    },

    "phase2_landscape": {
      "type": "object",
      "title": "phase2-landscape.json",
      "description": "Deduplicated domain list scored by appearance_count × avg_position_inverse.",
      "required": ["_summary", "domains"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "appearance_count", "avg_position", "score", "top_ranking_pages", "content_types"],
            "properties": {
              "domain": { "type": "string" },
              "appearance_count": { "type": "integer", "minimum": 1 },
              "avg_position": { "type": "number" },
              "score": { "type": "number" },
              "top_ranking_pages": { "type": "array", "items": { "type": "string" } },
              "content_types": {
                "type": "array",
                "items": { "$ref": "#/$defs/content_type" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase3_structure": {
      "type": "object",
      "title": "phase3/{domain-slug}/structure.json",
      "description": "Site structure analysis for a single competitor domain.",
      "required": ["_summary", "domain", "main_navigation", "content_sections", "hub_pages"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "domain": { "type": "string" },
        "main_navigation": { "type": "array", "items": { "type": "string" } },
        "content_sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "estimated_posts", "posting_frequency"],
            "properties": {
              "name": { "type": "string" },
              "url": { "type": "string" },
              "estimated_posts": { "type": "integer", "minimum": 0 },
              "posting_frequency": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "hub_pages": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "phase3_top_pages": {
      "type": "object",
      "title": "phase3/{domain-slug}/top-pages.json",
      "description": "Deep-dive analysis of top-ranking pages for a single competitor domain.",
      "required": ["_summary", "domain", "pages"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "domain": { "type": "string" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "title_tag", "h1", "headings", "estimated_word_count", "content_elements", "schema_markup", "internal_links_count", "ranks_for_keywords", "owns_featured_snippet"],
            "properties": {
              "url": { "type": "string" },
              "title_tag": { "type": "string" },
              "h1": { "type": "string" },
              "headings": { "type": "array", "items": { "type": "string" } },
              "estimated_word_count": { "type": "integer", "minimum": 0 },
              "content_elements": { "type": "array", "items": { "type": "string" } },
              "schema_markup": { "type": "array", "items": { "type": "string" } },
              "internal_links_count": { "type": "integer", "minimum": 0 },
              "ranks_for_keywords": { "type": "array", "items": { "type": "string" } },
              "owns_featured_snippet": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "phase4_synthesis": {
      "type": "object",
      "title": "phase4-synthesis.json",
      "description": "Cross-domain analysis: keyword opportunities, content gaps, format map, topical authority.",
      "required": ["_summary", "keyword_opportunities", "content_gaps", "content_format_map", "topical_authority_map", "assumptions"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "keyword_opportunities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["keyword", "demand_signal", "competition_signal", "opportunity_score", "intent", "featured_snippet_available", "current_snippet_owner", "rationale"],
            "properties": {
              "keyword": { "type": "string" },
              "demand_signal": { "type": "number" },
              "competition_signal": { "type": "number" },
              "opportunity_score": { "type": "number" },
              "intent": { "$ref": "#/$defs/search_intent" },
              "featured_snippet_available": { "type": "boolean" },
              "current_snippet_owner": { "type": ["string", "null"] },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "content_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "competitor_coverage", "user_coverage", "gap_type", "opportunity"],
            "properties": {
              "topic": { "type": "string" },
              "competitor_coverage": {
                "type": "object",
                "description": "Keyed by domain",
                "additionalProperties": { "$ref": "#/$defs/coverage_level" }
              },
              "user_coverage": { "$ref": "#/$defs/coverage_level" },
              "gap_type": {
                "type": "string",
                "enum": ["creation", "optimization", "consolidation"]
              },
              "opportunity": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "content_format_map": {
          "type": "object",
          "description": "Maps intent types to the content format that ranks for them",
          "additionalProperties": { "type": "string" }
        },
        "topical_authority_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cluster", "keywords_count", "hub_potential", "competitor_depth", "user_depth", "recommendation"],
            "properties": {
              "cluster": { "type": "string" },
              "keywords_count": { "type": "integer", "minimum": 1 },
              "hub_potential": { "$ref": "#/$defs/hub_potential" },
              "competitor_depth": {
                "type": "object",
                "description": "Keyed by domain",
                "additionalProperties": { "$ref": "#/$defs/strength_level" }
              },
              "user_depth": { "$ref": "#/$defs/strength_level" },
              "recommendation": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assumption", "confidence", "invalidation_condition"],
            "properties": {
              "assumption": { "type": "string", "description": "What is being assumed, stated plainly" },
              "confidence": {
                "type": "string",
                "enum": ["confirmed", "high", "medium", "low"],
                "description": "How confident we are this assumption holds"
              },
              "invalidation_condition": { "type": "string", "description": "What evidence would prove this assumption wrong" }
            },
            "additionalProperties": false
          },
          "description": "Explicit list of assumptions underlying synthesis conclusions. Downstream phases and future runs use this to verify whether prior conclusions still hold."
        }
      },
      "additionalProperties": false
    },

    "phase5_strategy": {
      "type": "object",
      "title": "phase5-strategy.json",
      "description": "Content strategy: page recommendations, content briefs, site structure improvements.",
      "required": ["_summary", "page_recommendations", "content_briefs", "site_structure"],
      "properties": {
        "_summary": { "$ref": "#/$defs/summary" },
        "page_recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "action", "primary_keyword", "secondary_keywords", "intent", "priority_score", "rationale"],
            "properties": {
              "url": { "type": "string" },
              "action": {
                "type": "string",
                "enum": ["create", "optimize", "consolidate"]
              },
              "primary_keyword": { "type": "string" },
              "secondary_keywords": { "type": "array", "items": { "type": "string" } },
              "intent": { "$ref": "#/$defs/search_intent" },
              "priority_score": { "type": "number" },
              "rationale": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "content_briefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_url", "primary_keyword", "intent", "recommended_word_count", "recommended_headings", "content_elements", "internal_link_targets", "featured_snippet_strategy", "competitor_benchmark"],
            "properties": {
              "target_url": { "type": "string" },
              "primary_keyword": { "type": "string" },
              "intent": { "$ref": "#/$defs/search_intent" },
              "recommended_word_count": { "type": "integer", "minimum": 1 },
              "recommended_headings": { "type": "array", "items": { "type": "string" } },
              "content_elements": { "type": "array", "items": { "type": "string" } },
              "internal_link_targets": { "type": "array", "items": { "type": "string" } },
              "featured_snippet_strategy": { "type": ["string", "null"] },
              "competitor_benchmark": {
                "type": "object",
                "required": ["current_top_result", "word_count", "weakness", "how_to_beat"],
                "properties": {
                  "current_top_result": { "type": "string" },
                  "word_count": { "type": "integer", "minimum": 0 },
                  "weakness": { "type": "string" },
                  "how_to_beat": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "site_structure": {
          "type": "object",
          "required": ["hub_pages_to_create", "internal_linking_improvements"],
          "properties": {
            "hub_pages_to_create": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["url", "role", "links_to"],
                "properties": {
                  "url": { "type": "string" },
                  "role": { "type": "string" },
                  "links_to": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            },
            "internal_linking_improvements": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "anchor_text", "reason"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "anchor_text": { "type": "string" },
                  "reason": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
